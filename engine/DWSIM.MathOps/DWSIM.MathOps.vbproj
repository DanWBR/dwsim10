<Project Sdk="Microsoft.NET.Sdk">

  <!--
    IPOPTSolver.vb talks to Cureos.Numerics, which here is DWSIM.Numerics.Ipopt rather than the
    .NET Framework wrapper over the native IPOPT. The LibOptimization wrappers were left behind
    for good: nothing in DWSIM or in the Plus extensions ever called them.
  -->

  <PropertyGroup>
    <RootNamespace>DWSIM.MathOps</RootNamespace>
    <AssemblyName>DWSIM.MathOps</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MathNet.Numerics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DWSIM.DrawingTools.Point\DWSIM.DrawingTools.Point.vbproj" />
    <ProjectReference Include="..\DWSIM.Numerics.Ipopt\DWSIM.Numerics.Ipopt.csproj" />
    <ProjectReference Include="..\DWSIM.MathOps.Mapack\DWSIM.MathOps.Mapack.csproj" />
  </ItemGroup>

</Project>
