{
  "industry": "Pharma and Food",
  "processes": [
    {
      "id": "cooling-crystallization",
      "name": "Cooling crystallization",
      "description": "A concentrated solution cooled in a crystallizer, where the solute above its solubility at the operating temperature comes out as crystals and the rest leaves with the mother liquor. The example solute is glucose in water.",
      "processType": "PhysicalSeparation",
      "compounds": [
        "Water",
        "Glucose"
      ],
      "keyCompounds": [
        "Glucose"
      ],
      "products": [
        "Glucose"
      ],
      "propertyPackage": {
        "name": "NRTL"
      },
      "unitSystem": "SI",
      "skeleton": {
        "objects": [
          {
            "tag": "FEED",
            "type": "MaterialStream",
            "temperature": 333.15,
            "pressure": 101325,
            "massFlow": 1,
            "composition": {
              "Water": 0.6,
              "Glucose": 0.4
            },
            "compositionBasis": "mass"
          },
          {
            "tag": "CR-100",
            "external": "Crystallizer",
            "properties": {
              "Mode": "Cooling",
              "SoluteCompound": "Glucose",
              "SolventCompound": "Water",
              "OperatingT_K": 278.15,
              "Sol_A": 0.4,
              "Sol_B": 0.005,
              "Sol_C": 0.0,
              "EvaporationFraction": 0.0
            }
          },
          {
            "tag": "CRYSTALS",
            "type": "MaterialStream"
          },
          {
            "tag": "MOTHER LIQUOR",
            "type": "MaterialStream"
          }
        ],
        "connections": [
          {
            "from": "FEED",
            "to": "CR-100",
            "toPort": 0
          },
          {
            "from": "CR-100",
            "to": "CRYSTALS",
            "fromPort": 0
          },
          {
            "from": "CR-100",
            "to": "MOTHER LIQUOR",
            "fromPort": 1
          }
        ]
      }
    },
    {
