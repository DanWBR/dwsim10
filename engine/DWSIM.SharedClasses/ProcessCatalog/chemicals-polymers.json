    {
      "id": "methanol-synthesis",
      "name": "Methanol synthesis",
      "description": "Syngas heated to the reactor temperature, methanol formed in an isothermal equilibrium reactor (CO and CO2 hydrogenation with the water-gas shift), then cooled and flashed into recycle gas and crude methanol.",
      "processType": "Transformation",
      "compounds": [
        "Hydrogen",
        "Carbon monoxide",
        "Carbon dioxide",
        "Methane",
        "Methanol",
        "Water"
      ],
      "keyCompounds": [
        "Methanol"
      ],
      "reactants": [
        "Hydrogen",
        "Carbon monoxide",
        "Carbon dioxide"
      ],
      "products": [
        "Methanol",
        "Water"
      ],
      "propertyPackage": {
        "name": "Peng-Robinson (PR)"
      },
      "unitSystem": "SI",
      "reactions": [
        {
          "type": "Equilibrium",
          "name": "CO hydrogenation",
          "stoichiometry": {
            "Carbon monoxide": -1,
            "Hydrogen": -2,
            "Methanol": 1
          },
          "baseCompound": "Carbon monoxide",
          "phase": "Vapor",
          "basis": "Fugacity",
          "units": "Pa"
        },
        {
          "type": "Equilibrium",
          "name": "Reverse water-gas shift",
          "stoichiometry": {
            "Carbon dioxide": -1,
            "Hydrogen": -1,
            "Carbon monoxide": 1,
            "Water": 1
          },
          "baseCompound": "Carbon dioxide",
          "phase": "Vapor",
          "basis": "Fugacity",
          "units": "Pa"
        }
      ],
