<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EditingForms/ stays behind, which is 46% of the project. Extenders/ScintillaExtender.vb and
    SupportClasses/ComboBoxColumnTemplates.vb go with it: one is the WinForms script editor, the
    other a DataGridView column template.
  -->

  <!--
    The two alternative PEM fuel cell correlations are unfinished: neither implements the two
    members its base class demands, and the .NET Framework project carries them as None items.
  -->

  <ItemGroup>
    <!--
      The Excel unit operation drives Excel over COM, or a commercial spreadsheet library; there
      is no cross-platform version of either.
    -->
    <Compile Remove="UnitOperations\Spreadsheet.vb" />
    <None Include="UnitOperations\Spreadsheet.vb" />
    <Compile Remove="UnitOperations\CleanEnergies\PEMFC_ChamberlineKim.vb" />
    <Compile Remove="UnitOperations\CleanEnergies\PEMFC_LarminieDicks.vb" />
    <None Include="UnitOperations\CleanEnergies\PEMFC_ChamberlineKim.vb" />
    <None Include="UnitOperations\CleanEnergies\PEMFC_LarminieDicks.vb" />
  </ItemGroup>

  <PropertyGroup>
    <RootNamespace>DWSIM.UnitOperations</RootNamespace>
    <AssemblyName>DWSIM.UnitOperations</AssemblyName>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoWarn>$(NoWarn);SYSLIB0011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="DWSIM.ExtensionMethods" />
    <Import Include="DWSIM.GlobalSettings" />
    <Import Include="DWSIM.Inspector" />
    <Import Include="DWSIM.Interfaces" />
    <Import Include="System.Data" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*;Icons\**\*;Resources\**\*">
      <LogicalName>$(RootNamespace).%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Languages\Strings.resx">
      <LogicalName>$(RootNamespace).Strings.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Languages\Strings.en.resx">
      <LogicalName>$(RootNamespace).Strings.en.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Languages\Strings.de.resx">
      <LogicalName>$(RootNamespace).Strings.de.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Languages\Strings.es.resx">
      <LogicalName>$(RootNamespace).Strings.es.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CapeOpen">
      <HintPath>..\..\lib\CapeOpen.dll</HintPath>
    </Reference>
    <Reference Include="Interop.CAPEOPEN110">
      <HintPath>..\..\lib\Interop.CAPEOPEN110.dll</HintPath>
      <EmbedInteropTypes>False</EmbedInteropTypes>
    </Reference>
    <Reference Include="Microsoft.Research.Oslo">
      <HintPath>..\..\lib\Microsoft.Research.Oslo.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IronPython" />
    <PackageReference Include="Mages" />
    <PackageReference Include="MathNet.Numerics" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="OxyPlot.Core" />
    <PackageReference Include="pythonnet" />
    <PackageReference Include="SharpZipLib" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="XMLUnit.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DWSIM.Drawing.SkiaSharp\DWSIM.Drawing.SkiaSharp.vbproj" />
    <ProjectReference Include="..\DWSIM.DrawingTools.Point\DWSIM.DrawingTools.Point.vbproj" />
    <ProjectReference Include="..\DWSIM.DrawingTools.SkiaSharp.Extended\DWSIM.DrawingTools.SkiaSharp.Extended.csproj" />
    <ProjectReference Include="..\DWSIM.ExtensionMethods\DWSIM.ExtensionMethods.vbproj" />
    <ProjectReference Include="..\DWSIM.FlowsheetSolver\DWSIM.FlowsheetSolver.vbproj" />
    <ProjectReference Include="..\DWSIM.GlobalSettings\DWSIM.GlobalSettings.vbproj" />
    <ProjectReference Include="..\DWSIM.Inspector\DWSIM.Inspector.vbproj" />
    <ProjectReference Include="..\DWSIM.Interfaces\DWSIM.Interfaces.vbproj" />
    <ProjectReference Include="..\DWSIM.MathOps\DWSIM.MathOps.vbproj" />
    <ProjectReference Include="..\DWSIM.MathOps.DotNumerics\DWSIM.MathOps.DotNumerics.csproj" />
    <ProjectReference Include="..\DWSIM.MathOps.Mapack\DWSIM.MathOps.Mapack.csproj" />
    <ProjectReference Include="..\DWSIM.MathOps.RandomOps\DWSIM.MathOps.RandomOps.csproj" />
    <ProjectReference Include="..\DWSIM.MathOps.SwarmOps\DWSIM.MathOps.SwarmOps.csproj" />
    <ProjectReference Include="..\DWSIM.Numerics.Ipopt\DWSIM.Numerics.Ipopt.csproj" />
    <ProjectReference Include="..\DWSIM.SharedClasses\DWSIM.SharedClasses.vbproj" />
    <ProjectReference Include="..\DWSIM.SharedClassesCSharp\DWSIM.SharedClassesCSharp.csproj" />
    <ProjectReference Include="..\DWSIM.Thermodynamics\DWSIM.Thermodynamics.vbproj" />
    <ProjectReference Include="..\DWSIM.Thermodynamics.ReaktoroPropertyPackage\DWSIM.Thermodynamics.ReaktoroPropertyPackage.vbproj" />
    <ProjectReference Include="..\DWSIM.XMLSerializer\DWSIM.XMLSerializer.vbproj" />
    <ProjectReference Include="..\..\ui\DWSIM.UI.Shared.Avalonia\DWSIM.UI.Shared.Avalonia.csproj" />
  </ItemGroup>

</Project>
