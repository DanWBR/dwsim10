<Project>

  <!--
    Every package version lives here, so the engine, the UI and the tests cannot drift apart.
    Projects reference packages without a Version attribute.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Engine">
    <PackageVersion Include="AutomaticGraphLayout" Version="1.1.12" />
    <PackageVersion Include="EPPlus" Version="4.5.3.3" />
    <PackageVersion Include="FileHelpers" Version="3.5.1" />
    <PackageVersion Include="Flee" Version="2.0.0" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.11.70" />
    <!-- the LGPL fork of iTextSharp, which the automation PDF report is written against -->
    <PackageVersion Include="iTextSharp-LGPL" Version="4.1.6" />
    <PackageVersion Include="IronPython" Version="3.4.2" />
    <PackageVersion Include="DynamicLanguageRuntime" Version="1.3.5" />
    <PackageVersion Include="LiteDB" Version="5.0.19" />
    <PackageVersion Include="Mages" Version="2.0.2" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="NLog" Version="5.3.4" />
    <PackageVersion Include="pythonnet" Version="3.1.0" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />
    <PackageVersion Include="XMLUnit.Core" Version="2.9.1" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="9.0.0" />
    <!-- pinned over the 4.7.0 that EPPlus 4.5 asks for, which has a known vulnerability -->
    <PackageVersion Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="Compound and phase equilibrium data">
    <PackageVersion Include="NCDK" Version="1.6.1" />
    <PackageVersion Include="ShellProgressBar" Version="5.2.0" />
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup Label="Drawing">
    <PackageVersion Include="SkiaSharp" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="2.88.9" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" />
    <PackageVersion Include="OxyPlot.Core" Version="2.0.0" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageVersion Include="Avalonia" Version="11.3.15" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.3.15" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.3.15" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.3.15" />
    <!-- the DataGrid ships on its own cadence: 11.3.13 is the newest of the 11.3 line -->
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="11.3.13" />
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="11.3.15" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.3.15" />
    <PackageVersion Include="Avalonia.Skia" Version="11.3.15" />
    <PackageVersion Include="Avalonia.AvaloniaEdit" Version="11.2.0" />
    <PackageVersion Include="Dock.Avalonia" Version="11.3.12.1" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="11.3.12.1" />
    <PackageVersion Include="Dock.Model.Avalonia" Version="11.3.12.1" />
    <PackageVersion Include="Dock.Serializer.Newtonsoft" Version="11.3.12.1" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NUnit" Version="4.2.2" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="9.0.0" />
  </ItemGroup>

</Project>
