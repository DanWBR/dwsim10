<Window xmlns="https://github.com/avaloniaui"
        xmlns:loc="using:DWSIM.UI.Shared.Avalonia"
        xmlns:i18n="using:DWSIM.UI.Desktop.Avalonia"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="DWSIM.UI.Desktop.Avalonia.MainWindow"
        Title="DWSIM"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

  <!-- Button styles (hero, tool) are now global in App.axaml -->

  <DockPanel LastChildFill="True">

    <!-- Menu: replaced by the menu of the active simulation while one is open -->
    <!-- the strip on the right is where a main-window extension puts itself, as the
         Windows interface does with the assistant -->
    <DockPanel DockPanel.Dock="Top" LastChildFill="True">
      <StackPanel DockPanel.Dock="Right" Name="MenuBarExtensions" Orientation="Horizontal"
                  Spacing="2" VerticalAlignment="Center" Margin="4,0">
        <Button Name="BtnSupportPatreon" Classes="link"
                ToolTip.Tip="{loc:Localize 'Support DWSIM on Patreon (opens patreon.com)'}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="&#x2764;" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Localize 'Support DWSIM and become a Patron'}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
      <ContentControl Name="MenuHost">
        <Menu Name="BaseMenu">
        <MenuItem i18n:LocalizationMenu.SourceHeader="_File" Header="{loc:Localize '_File'}">
          <MenuItem i18n:LocalizationMenu.SourceHeader="_New Simulation..." Header="{loc:Localize '_New Simulation...'}"  Name="MenuNew" />
          <MenuItem i18n:LocalizationMenu.SourceHeader="_Open Simulation..." Header="{loc:Localize '_Open Simulation...'}" Name="MenuOpen" />
          <MenuItem i18n:LocalizationMenu.SourceHeader="Open _Recent" Header="{loc:Localize 'Open _Recent'}"        Name="MenuRecent" />
          <Separator />
          <MenuItem i18n:LocalizationMenu.SourceHeader="E_xit" Header="{loc:Localize 'E_xit'}"               Name="MenuExit" />
        </MenuItem>
        <MenuItem i18n:LocalizationMenu.SourceHeader="_Edit" Header="{loc:Localize '_Edit'}">
          <MenuItem i18n:LocalizationMenu.SourceHeader="_Preferences..." Header="{loc:Localize '_Preferences...'}"     Name="MenuPrefs" />
        </MenuItem>
        <MenuItem i18n:LocalizationMenu.SourceHeader="_Help" Header="{loc:Localize '_Help'}">
          <MenuItem i18n:LocalizationMenu.SourceHeader="_User Guide (HTML)" Header="{loc:Localize '_User Guide (HTML)'}"  Name="MenuUserGuide" />
          <Separator />
          <MenuItem i18n:LocalizationMenu.SourceHeader="_Support" Header="{loc:Localize '_Support'}"            Name="MenuHelpSupport" />
          <MenuItem i18n:LocalizationMenu.SourceHeader="Report a _Bug" Header="{loc:Localize 'Report a _Bug'}"       Name="MenuHelpBug" />
          <MenuItem i18n:LocalizationMenu.SourceHeader="Go to DWSIM's _Website" Header="Go to DWSIM's _Website" Name="MenuHelpWebsite" />
          <Separator />
          <MenuItem i18n:LocalizationMenu.SourceHeader="_About DWSIM..." Header="{loc:Localize '_About DWSIM...'}"     Name="MenuAbout" />
          </MenuItem>
        </Menu>
      </ContentControl>
    </DockPanel>

    <!-- Bottom container for extension panels (e.g. Support/licensing bar) -->
    <StackPanel Name="BottomPane" DockPanel.Dock="Bottom" />

    <!-- Body: the welcome screen until a simulation is open, then the document tabs -->
    <Grid>

    <Grid Name="WelcomeHost" ColumnDefinitions="380,3*,2*" Margin="0">

      <!-- Left: "Get Started", the same sections the Windows welcome screen stacks -->
      <ScrollViewer Grid.Column="0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Border BorderThickness="0,0,1,0" Padding="20,18">
          <StackPanel Spacing="18">

            <TextBlock Text="{loc:Localize 'Welcome to DWSIM!'}" FontSize="20" FontWeight="Bold" />

            <!-- Process Modeling -->
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize 'Process Modeling'}" Classes="welcomeHeader" />
              <TextBlock Text="{loc:Localize 'Create or load chemical steady-state or dynamic process models.'}"
                         Classes="welcomeSubtitle" />
              <Button Name="LnkNew"          Classes="link" Content="{loc:Localize 'Create New'}" />
              <Button Name="LnkNewWizard"    Classes="link" Content="{loc:Localize 'Create New with Wizard'}" />
              <Button Name="LnkNewFromDrawing" Classes="link" Content="Create New from PFD or P&amp;ID"
                      ToolTip.Tip="A new, empty flowsheet built from a process flow diagram or a P&amp;ID read by the AI Assistant." />
              <Button Name="LnkLoadFile"     Classes="link" Content="{loc:Localize 'Load File'}" />
              <Button Name="LnkImportSimulation" Classes="link" Content="Import from Other Simulators"
                      ToolTip.Tip="A DWSIM flowsheet built from a simulation file of another process simulator." />
            </StackPanel>

            <!-- Compound creation / data regression -->
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize 'User Compound Creation / Data Regression'}" Classes="welcomeHeader" />
              <Button Name="LnkNewRegression"  Classes="link" Content="{loc:Localize 'Create New Data Regression Study'}" />
              <Button Name="LnkLoadRegression" Classes="link" Content="{loc:Localize 'Load Study from File'}" />
              <Button Name="LnkNewCompound"    Classes="link" Content="{loc:Localize 'Create New Compound'}" />
              <Button Name="LnkNewSolid"       Classes="link" Content="{loc:Localize 'Quick Create New Solid'}" />
              <Button Name="LnkNewBlackOil"    Classes="link" Content="{loc:Localize 'Quick Create New Black Oil'}" />
              <Button Name="LnkNewCompoundWiz" Classes="link" Content="{loc:Localize 'Create New (with Wizard)'}" />
              <Button Name="LnkDatabaseManager" Classes="link" Content="{loc:Localize 'Manage User Databases...'}" />
            </StackPanel>

            <!-- Documentation -->
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize 'Documentation'}" Classes="welcomeHeader" />
              <Button Name="LnkGuideHtml"  Classes="link" Content="{loc:Localize 'User Guide (HTML)'}" />
              <Button Name="LnkGuidePdf"   Classes="link" Content="{loc:Localize 'User Guide (PDF)'}" />
              <Button Name="LnkTutorials"  Classes="link" Content="{loc:Localize 'Online Tutorials'}" />
              <Button Name="LnkLearning"   Classes="link" Content="{loc:Localize 'Learning Resources'}" />
              <Button Name="LnkPublications" Classes="link" Content="{loc:Localize 'View Publications'}" />
              <Button Name="LnkApiDocs"    Classes="link" Content="{loc:Localize 'API Documentation'}" />
            </StackPanel>

            <!-- Support -->
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize 'Support/Sponsor'}" Classes="welcomeHeader" />
              <TextBlock Text="{loc:Localize 'Support/Sponsor open-source DWSIM development activities.'}"
                         Classes="welcomeSubtitle" />
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <Button Name="BtnSponsorGitHub" Classes="tool" Content="{loc:Localize 'GitHub Sponsors'}" />
                <Button Name="BtnSponsorPatreon" Classes="tool" Content="Patreon" />
                <Button Name="BtnSponsorCoffee" Classes="tool" Content="{loc:Localize 'Buy Me a Coffee'}" />
              </StackPanel>
            </StackPanel>

            <!-- Preferences / about, which the Windows screen keeps on its toolbar -->
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Localize 'Application'}" Classes="welcomeHeader" />
              <Button Name="BtnSettings" Classes="tool" Content="{loc:Localize 'Preferences'}" />
              <Button Name="BtnAbout"    Classes="tool" Content="{loc:Localize 'About DWSIM'}" />
            </StackPanel>

          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- Right: recent files, samples and the FOSSEE flowsheets -->
      <TabControl Name="WelcomeTabs" Grid.Column="1" TabStripPlacement="Top" Margin="0">

        <TabItem Header="{loc:Localize 'Recent Files'}">
          <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Localize 'Recent Simulations'}"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeNormal}"
                       Margin="0,0,0,10" />
            <ListBox Name="RecentFilesList"
                     SelectionMode="Single"
                     CornerRadius="4"
                     BorderThickness="1" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:Localize 'Samples'}">
          <DockPanel Margin="16">
            <TextBlock DockPanel.Dock="Top"
                       Text="{loc:Localize 'Sample Simulations'}"
                       FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeNormal}"
                       Margin="0,0,0,10" />
            <ListBox Name="SamplesList"
                     CornerRadius="4"
                     BorderThickness="1" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:Localize 'Case Library'}">
          <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
              <TextBlock Text="{loc:Localize 'DWSIM Case Library'}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeNormal}" />
              <TextBlock TextWrapping="Wrap" Classes="welcomeSubtitle"
                         Text="{loc:Localize 'A community library of real industrial process cases modeled in DWSIM: crude distillation, hydrotreating, gas processing, separations and more. Double-click a case to download and open it.'}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="BtnCaseLibraryRepo"    Classes="tool" Content="{loc:Localize 'Browse Repository'}" />
                <Button Name="BtnCaseLibraryContribute" Classes="tool" Content="{loc:Localize 'Contribute a Case'}" />
              </StackPanel>
              <TextBlock Text="{loc:Localize 'Available Cases'}" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel>
            <ListBox Name="CaseLibraryList" CornerRadius="4" BorderThickness="1" />
          </DockPanel>
        </TabItem>

        <TabItem Header="{loc:Localize 'FOSSEE Flowsheets'}">
          <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,10">
              <TextBlock Text="{loc:Localize 'About the Project'}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeNormal}" />
              <TextBlock TextWrapping="Wrap" Classes="welcomeSubtitle"
                         Text="{loc:Localize 'FOSSEE, IIT Bombay, invites chemical engineering students, faculty and practitioners to the flowsheeting project using DWSIM. We want you to convert existing flowsheets into DWSIM and get honoraria and certificates.'}" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Button Name="BtnFosseeProject" Classes="tool" Content="{loc:Localize 'Flowsheeting Project'}" />
                <Button Name="BtnFosseeSite"    Classes="tool" Content="{loc:Localize 'FOSSEE Website'}" />
              </StackPanel>
              <TextBlock Text="{loc:Localize 'Completed Flowsheets'}" FontWeight="SemiBold" Margin="0,6,0,0" />
            </StackPanel>
            <ListBox Name="FosseeList" CornerRadius="4" BorderThickness="1" />
          </DockPanel>
        </TabItem>

      </TabControl>

      <!-- Details of the simulation selected in the lists, read from the file without loading it -->
      <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource SplitterBrush}">
        <DockPanel>
        <!-- opens the item shown, the same as a double-click in the list -->
        <Button Name="DetailsOpen" DockPanel.Dock="Bottom" Classes="detailsOpen" Content="{loc:Localize 'Open'}"
                Margin="20,8,20,18" IsVisible="False" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" Margin="20,52,20,20">
            <Border Name="DetailsPreviewCard" Classes="detailsCard" Padding="10" IsVisible="False">
              <Image Name="DetailsPreview" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="300"
                     HorizontalAlignment="Center" Cursor="Hand"
                     ToolTip.Tip="Click to see the picture in a larger window" />
            </Border>
            <StackPanel Spacing="4">
              <TextBlock Name="DetailsTitle" Text="Simulation Details" TextWrapping="Wrap"
                         FontSize="20" FontWeight="SemiBold" />
              <TextBlock Name="DetailsSubtitle" TextWrapping="Wrap" Opacity="0.65" IsVisible="False" />
            </StackPanel>
            <Border Name="DetailsWarning" Classes="detailsWarning" IsVisible="False">
              <TextBlock Name="DetailsWarningText" />
            </Border>
            <SelectableTextBlock Name="DetailsComments" TextWrapping="Wrap" IsVisible="False"
                                 FontSize="{DynamicResource FontSizeNormal}" LineHeight="18" />
            <StackPanel Name="DetailsSections" Spacing="16" />
            <StackPanel Name="DetailsFooter" Spacing="2" Opacity="0.55" IsVisible="False" />
            <TextBlock Name="DetailsNote" TextWrapping="Wrap" Opacity="0.6"
                       Text="Select a simulation in the list to see its details." />
          </StackPanel>
        </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>

    <!-- Simulation tabs hosted by hand: every open simulation stays parented in DocContentHost
         (only the active one visible), so its inner dock is never detached and returned blank. -->
    <Grid Name="DocumentsHost" IsVisible="False" RowDefinitions="Auto,*">
      <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="#22000000">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Name="DocTabBar" Orientation="Horizontal" Margin="4,2,4,0" />
        </ScrollViewer>
      </Border>
      <Panel Name="DocContentHost" Grid.Row="1" />
    </Grid>

    </Grid>

  </DockPanel>

</Window>
