<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DWSIM.UI.Desktop.Avalonia.TrueCriticalPointWindow"
        x:CompileBindings="False"
        Title="True Critical Point"
        Width="620" Height="440"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True">

    <Border DockPanel.Dock="Top" Padding="10" BorderThickness="0,0,0,1">
      <StackPanel Spacing="8">
        <TextBlock Text="Calculates the true critical point of a mixture from the Peng-Robinson or Soave-Redlich-Kwong EOS. The selected stream must use one of those property packages."
                   FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap" Opacity="0.8" />
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="Material Stream:" VerticalAlignment="Center" />
          <ComboBox Name="CbStream" Width="260" />
          <Button Name="BtnCalculate" Classes="action" Content="Calculate" Width="100" Margin="8,0,0,0" />
          <Button Name="BtnCopy" Classes="panel" Content="Copy" Width="80" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="8,3" BorderThickness="0,1,0,0">
      <TextBlock Name="StatusLabel" Text="Select a material stream and press Calculate." FontSize="{DynamicResource FontSizeSmall}" />
    </Border>

    <TextBox Name="TbResults" Margin="8" IsReadOnly="True" AcceptsReturn="True"
             TextWrapping="NoWrap" FontFamily="Consolas,Menlo,Monospace" FontSize="{DynamicResource FontSizeNormal}"
             VerticalContentAlignment="Top" />

  </DockPanel>

</Window>
