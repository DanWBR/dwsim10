<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dac="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
             xmlns:dcp="clr-namespace:Dock.Controls.ProportionalStackPanel;assembly=Dock.Controls.ProportionalStackPanel"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="DWSIM.UI.Desktop.Avalonia.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <!-- Fluent/Semi default to 14 px for control content, which reads much larger than the
           8.25 pt (11 px) the WinForms UI uses. This is what menus, buttons, pickers and
           text boxes pick up. -->
      <x:Double x:Key="ControlContentThemeFontSize">12</x:Double>
      <x:Double x:Key="FontSizeNormal">12</x:Double>
      <x:Double x:Key="FontSizeSmall">11</x:Double>
      <!-- The floor Fluent gives text boxes, combo boxes, spinners and pickers: 32 px, which
           reads far taller than the WinForms fields. Down to 24, to match them, in one place. -->
      <x:Double x:Key="TextControlThemeMinHeight">24</x:Double>

      <!-- AvaloniaEdit's Fluent SearchPanel resolves ContentControlThemeFontFamily as a
           StaticResource; the Semi theme does not define that key, so opening the Script Manager
           threw KeyNotFoundException and crashed the app. Define it here (as the Fluent theme
           does) so the lookup always succeeds. -->
      <FontFamily x:Key="ContentControlThemeFontFamily">$Default</FontFamily>

      <!-- Colours that must differ per theme are defined here, so the palette header, the
           dock tab text, the welcome-screen links and the dock splitter all follow the
           active light/dark variant instead of a single hardcoded value. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="PaletteHeaderBackground">#E6EBF5</SolidColorBrush>
          <SolidColorBrush x:Key="DockTabForeground">#5A5A5A</SolidColorBrush>
          <SolidColorBrush x:Key="DockTabForegroundSelected">#141414</SolidColorBrush>
          <SolidColorBrush x:Key="TabSelectedAccent">#2E7CD6</SolidColorBrush>
          <SolidColorBrush x:Key="LinkForeground">#1565C0</SolidColorBrush>
          <SolidColorBrush x:Key="SplitterBrush">#C4C4C4</SolidColorBrush>
          <!-- Gradient action buttons (carried over from the mobile theme). -->
          <LinearGradientBrush x:Key="AppButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#FFFFFF" />
            <GradientStop Offset="1" Color="#EFF3F9" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AppButtonBackgroundHover" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#F5F9FF" />
            <GradientStop Offset="1" Color="#E2EAF6" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AppButtonBackgroundPressed" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#DDE7F5" />
            <GradientStop Offset="1" Color="#CFDCEF" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="AppButtonBorder" Color="#D3DCE8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="PaletteHeaderBackground">#2D2D30</SolidColorBrush>
          <SolidColorBrush x:Key="DockTabForeground">#B4B4B4</SolidColorBrush>
          <SolidColorBrush x:Key="DockTabForegroundSelected">#F2F2F2</SolidColorBrush>
          <SolidColorBrush x:Key="TabSelectedAccent">#2E7CD6</SolidColorBrush>
          <SolidColorBrush x:Key="LinkForeground">#5AA9E6</SolidColorBrush>
          <SolidColorBrush x:Key="SplitterBrush">#3A3A3A</SolidColorBrush>
          <!-- Gradient action buttons (carried over from the mobile theme). -->
          <LinearGradientBrush x:Key="AppButtonBackground" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#3A4150" />
            <GradientStop Offset="1" Color="#2C323D" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AppButtonBackgroundHover" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#454D5E" />
            <GradientStop Offset="1" Color="#353C49" />
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="AppButtonBackgroundPressed" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Offset="0" Color="#2A303B" />
            <GradientStop Offset="1" Color="#22272F" />
          </LinearGradientBrush>
          <SolidColorBrush x:Key="AppButtonBorder" Color="#4A5261" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Unify the Dock active/selected header look under Semi: the active tool-dock grip and
           its title read white-on-accent, matching the centre document tab. These keys are the
           ones the DockFluent tab/chrome templates resolve for their active/selected states. -->
      <SolidColorBrush x:Key="DockSurfaceHeaderActiveBrush" Color="#2E7CD6" />
      <SolidColorBrush x:Key="DockTabActiveForegroundBrush" Color="White" />
      <SolidColorBrush x:Key="DockDocumentTabSelectedForegroundBrush" Color="White" />
      <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="White" />

    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <semi:SemiTheme Locale="en-US" />
    <DockFluentTheme DensityStyle="Normal" />
    <semi:DataGridSemiTheme />
    <!-- the script editor needs an explicit theme or it draws nothing -->
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

    <!-- =================================================================
         Semi drives the look. What remains here is colour-agnostic density
         carried over from the compact desktop layout, flat toolbars, and the
         few theme-aware fixes the Semi swap needs (links, tabs, splitter).
         ================================================================= -->

    <!-- Menus and popup context menus render in their own popup layer and do not
         inherit the window font, so set the scaled size explicitly. -->
    <Style Selector="Menu">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>
    <Style Selector="MenuItem">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>
    <Style Selector="ContextMenu">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>

    <Style Selector="Window">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>

    <!-- The pruned custom TabControl template stretched its selected content to fill; Semi's
         default leaves it at desired size, so fill-content (e.g. the About license box) collapses.
         Restore stretch so a TextBox in a fill slot takes the remaining height. -->
    <Style Selector="TabControl">
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- A touch more height on the TabControl headers so they are not cramped. -->
    <Style Selector="TabItem">
      <Setter Property="MinHeight" Value="{DynamicResource TabHeaderMinHeight}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Semi ignores ControlContentThemeFontSize (a Fluent key), so control font sizes must be
         set explicitly per control. They all read the one FontSizeNormal resource above, so the
         whole UI font size is changed in a single place. Compact the default (non-classed) buttons
         so Semi's 32 px/14 pt chrome does not tower over the fields; classed toolbar/link buttons
         override this, and the toolbar glyph buttons keep their inline FontSize (a local value
         wins over this style). -->
    <Style Selector="Button">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
      <Setter Property="Padding" Value="{DynamicResource ControlPadding}" />
    </Style>

    <!-- Gradient action buttons, carried over from the DWSIM 10 Mobile theme: a soft vertical
         gradient, a light border and rounded corners, following the light/dark variant. Scoped
         POSITIVELY to DWSIM's own content-button classes. Framework template buttons - the Dock
         chrome pin/close, spinner up/down, and so on - carry none of these classes, so they never
         pick up the gradient and stay flat; links and toolbar buttons keep their borderless styles. -->
    <Style Selector="Button.panel, Button.dialog, Button.action, Button.tool, Button.wizard, Button.group">
      <Setter Property="Background" Value="{DynamicResource AppButtonBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.panel:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.dialog:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.action:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.wizard:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.group:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}" />
    </Style>
    <Style Selector="Button.panel:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.dialog:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.action:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.tool:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.wizard:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.group:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppButtonBackgroundPressed}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppButtonBorder}" />
    </Style>
    <Style Selector="ToggleButton">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>

    <!-- Combo boxes: keep Semi's natural height (forcing a short MinHeight squished them);
         only bring the font down to 11. -->
    <Style Selector="ComboBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>
    <!-- Check boxes: match the 11 px type, add a gap between the box and its label, and
         breathe vertically between rows (Semi packs them tight). -->
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="8,0,0,0" />
      <Setter Property="Margin" Value="0,3,0,3" />
    </Style>

    <!-- Compact dock tab headers. Semi/DockFluent leave them tall; force a compact height. -->
    <Style Selector="dac|ToolTabStripItem">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DockTabForeground}" />
    </Style>
    <Style Selector="dac|DocumentTabStripItem">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Height" Value="{DynamicResource TabStripHeight}" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <!-- The close X binds its fill to the item Foreground, so set it here (not only on the
           title TextBlock) or the X is invisible. -->
      <Setter Property="Foreground" Value="{DynamicResource DockTabForeground}" />
    </Style>

    <!-- Under Semi the DockFluent tab foreground resolves to an invisible brush and the title
         font stays large; force colour (per theme) and size on the tab title TextBlock, which
         is robust to the tab template. -->
    <Style Selector="dac|DocumentTabStripItem TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DockTabForeground}" />
    </Style>
    <Style Selector="dac|ToolTabStripItem TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource DockTabForeground}" />
    </Style>
    <!-- Also centre the content presenter so the selected tab's title is not pushed down. -->
    <Style Selector="dac|ToolTabStripItem /template/ ContentPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="dac|DocumentTabStripItem /template/ ContentPresenter">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Standardise the selected tab: an accent-filled header with white text, held in every
         focus state. DockFluent drops the fill to a pale colour when the strip loses focus
         (via :not(:active):selected, more specific than a plain :selected), so the overrides
         below match that specificity to win. Applies to documents and tools alike. -->
    <Style Selector="dac|DocumentTabStripItem:selected">
      <Setter Property="Background" Value="{DynamicResource TabSelectedAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="dac|DocumentTabStripItem:active:selected">
      <Setter Property="Background" Value="{DynamicResource TabSelectedAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="dac|DocumentTabStripItem:not(:active):selected">
      <Setter Property="Background" Value="{DynamicResource TabSelectedAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="dac|DocumentTabStripItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="dac|ToolTabStripItem:selected">
      <Setter Property="Background" Value="{DynamicResource TabSelectedAccent}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="dac|ToolTabStripItem:selected:pointerover">
      <Setter Property="Background" Value="{DynamicResource TabSelectedAccent}" />
    </Style>
    <Style Selector="dac|ToolTabStripItem:selected TextBlock">
      <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The side tool docks carry a ToolChromeControl title (grip), not a tab. Keep its inactive
         title readable (theme foreground); its active state is unified through the Dock brush
         overrides in Application.Resources so it reads white-on-accent like the centre. -->
    <Style Selector="dac|ToolChromeControl /template/ TextBlock#PART_Title">
      <Setter Property="Foreground" Value="{DynamicResource DockTabForeground}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>

    <!-- The proportional dock splitter needs a non-null background to be hit-testable, or it
         cannot be dragged. Set the resize cursor per orientation: splitters in a horizontal
         panel resize left/right, those in a vertical panel resize up/down. -->
    <Style Selector="dcp|ProportionalStackPanelSplitter">
      <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
      <Setter Property="MinWidth" Value="4" />
      <Setter Property="MinHeight" Value="4" />
      <Setter Property="Cursor" Value="SizeWestEast" />
    </Style>
    <Style Selector="dcp|ProportionalStackPanel[Orientation=Vertical] > dcp|ProportionalStackPanelSplitter">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>

    <!-- Compact data grids -->
    <Style Selector="DataGrid">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="RowHeight" Value="{DynamicResource DataGridRowHeight}" />
      <Setter Property="MinColumnWidth" Value="40" />
      <Setter Property="ColumnHeaderHeight" Value="{DynamicResource DataGridHeaderHeight}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="DataGridCell">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="DataGridRow">
      <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TextBlock.groupHeader">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- Editor panel compact controls -->
    <Style Selector="StackPanel.editorPanel TextBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    </Style>
    <Style Selector="StackPanel.editorPanel ComboBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.editorPanel NumericUpDown">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    </Style>
    <Style Selector="StackPanel.editorPanel CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
    </Style>
    <Style Selector="StackPanel.editorPanel AutoCompleteBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="MinHeight" Value="{DynamicResource TextControlThemeMinHeight}" />
    </Style>

    <!-- =================================================================
         WELCOME SCREEN
         The left column reads as flat, left-aligned text links, and the
         secondary action buttons stretch and left-align (Semi chrome kept).
         ================================================================= -->
    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{DynamicResource LinkForeground}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.tool">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="TextBlock.welcomeHeader">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.welcomeSubtitle">
      <Setter Property="FontSize" Value="{DynamicResource FontSizeNormal}" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Flat, borderless icon buttons on the toolbars; the hover/pressed colours come from Semi
         (so they follow the light/dark variant), only the geometry is set here. -->
    <Style Selector="Button.toolbar, ToggleButton.toolbar">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="MinWidth" Value="{DynamicResource ToolbarButtonMinSize}" />
      <Setter Property="MinHeight" Value="{DynamicResource ToolbarButtonMinSize}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <!-- A checked toolbar toggle (Calculator Active, Simultaneous Adjust, Connect, Dynamic Mode)
         must read as "on". The base .toolbar style forces a transparent background, and Semi's own
         template binds the content presenter's background to it and turns the checked glyph white,
         so the white glyph landed on the transparent toolbar and the icon vanished. Paint the
         checked fill directly on the content presenter Semi actually renders (PART_ContentPresenter),
         with literal colours (a theme-dictionary DynamicResource resolved to nothing in this setter
         context) - solid accent fill, white glyph - so the icon always contrasts with the bar. -->
    <Style Selector="ToggleButton.toolbar:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2E7CD6" />
      <Setter Property="BorderBrush" Value="#2E7CD6" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.toolbar:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3A88E0" />
      <Setter Property="BorderBrush" Value="#3A88E0" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.toolbar:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2569BE" />
      <Setter Property="BorderBrush" Value="#2569BE" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.subtoolbar, Button.nav, Button.compact">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="MinWidth" Value="{DynamicResource SubToolbarButtonMinSize}" />
      <Setter Property="MinHeight" Value="{DynamicResource SubToolbarButtonMinSize}" />
      <Setter Property="FontSize" Value="{DynamicResource ToolbarIconSize}" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- The flowsheet drawing toolbar is a WrapPanel (so it can flow to a second line); it has
         no Spacing, so give its items margins and render group dividers as thin vertical bars. -->
    <Style Selector="Border.vdivider">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="{DynamicResource VdividerHeight}" />
      <Setter Property="Margin" Value="5,2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource SplitterBrush}" />
    </Style>
    <Style Selector="Border#DrawingToolbarBorder Button">
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Border#DrawingToolbarBorder ToggleButton">
      <Setter Property="Margin" Value="1,0" />
    </Style>
    <Style Selector="Border#DrawingToolbarBorder CheckBox">
      <Setter Property="Margin" Value="4,0" />
    </Style>

  </Application.Styles>

</Application>
