<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DWSIM.UI.Desktop.Avalonia.OptimizerWindow"
        x:CompileBindings="False"
        Title="Flowsheet Optimizer"
        Width="1040" Height="680"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="8" LastChildFill="True">

    <!-- ===== Case management ===== -->
    <Border DockPanel.Dock="Top" Padding="0,0,0,8" BorderThickness="0,0,0,1" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Case:" VerticalAlignment="Center" />
        <ComboBox Name="CbCase" Width="240" />
        <Button Name="BtnNewCase" Classes="panel" Content="New" Width="70" />
        <Button Name="BtnCloneCase" Classes="panel" Content="Duplicate" Width="90" />
        <Button Name="BtnDeleteCase" Classes="panel" Content="Delete" Width="70" />
        <TextBlock Text="Cases are stored with the simulation; save the file to keep them."
                   VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7" Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <TextBlock Name="TbProgress" Text="" VerticalAlignment="Center"
                 FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" />
      <Button Name="BtnClose" Classes="dialog" Content="Close" Width="80" IsCancel="True" />
    </StackPanel>

    <Grid ColumnDefinitions="320,4,330,4,*">

      <!-- ===== Left: case settings ===== -->
      <ScrollViewer Grid.Column="0">
        <StackPanel Spacing="6" Margin="0,0,4,0">

          <TextBlock Text="Case Identification" FontWeight="SemiBold" />
          <TextBlock Text="Name:" />
          <TextBox Name="TbCaseName" />
          <TextBlock Text="Description:" />
          <TextBox Name="TbCaseDescription" />

          <Separator Margin="0,8" />

          <TextBlock Text="Objective" FontWeight="SemiBold" />
          <TextBlock Text="Optimization Type:" />
          <ComboBox Name="CbType" HorizontalAlignment="Stretch" />
          <TextBlock Text="Objective Function:" Margin="0,4,0,0" />
          <ComboBox Name="CbObjFuncType" HorizontalAlignment="Stretch" />
          <TextBlock Text="Expression (uses IND / AUX / DEP variable names):" Margin="0,4,0,0"
                     TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" />
          <TextBox Name="TbExpression" />

          <Separator Margin="0,8" />

          <TextBlock Text="Optimization Control" FontWeight="SemiBold" />
          <TextBlock Text="Method:" />
          <ComboBox Name="CbMethod" HorizontalAlignment="Stretch" />
          <TextBlock Text="Maximum Iterations:" Margin="0,4,0,0" />
          <TextBox Name="TbMaxIts" />
          <TextBlock Text="Absolute Tolerance:" Margin="0,4,0,0" />
          <TextBox Name="TbTolerance" />
          <TextBlock Text="Numerical Derivative Step:" Margin="0,4,0,0" />
          <TextBox Name="TbEpsilon" />
          <TextBlock Text="Barrier Multiplier:" Margin="0,4,0,0" />
          <TextBox Name="TbBarrier" />

          <Separator Margin="0,8" />

          <Button Name="BtnRun" Classes="action" Content="Run Optimization"
                  HorizontalAlignment="Stretch" FontWeight="SemiBold" />
          <Button Name="BtnAbort" Classes="panel" Content="Abort Run"
                  HorizontalAlignment="Stretch" IsEnabled="False" />
          <Button Name="BtnRestore" Classes="panel" Content="Restore Initial Values"
                  HorizontalAlignment="Stretch" />

        </StackPanel>
      </ScrollViewer>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" HorizontalAlignment="Stretch" />

      <!-- ===== Middle: variables ===== -->
      <DockPanel Grid.Column="2" Margin="4,0">

        <TextBlock DockPanel.Dock="Top" Text="Variables" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8"
                   Margin="0,2,0,6"
                   Text="IND: a decision variable. DEP: the value being minimized/maximized. AUX: only referenced by the expression. CON: kept within its limits at the solution." />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
          <Button Name="BtnAddVar" Classes="panel" Content="Add Variable" Width="110" />
          <Button Name="BtnRemoveVar" Classes="panel" Content="Remove" Width="90" />
        </StackPanel>

        <ListBox Name="LbVariables" DockPanel.Dock="Top" Height="150" />

        <ScrollViewer>
          <StackPanel Name="VarEditor" Spacing="6" Margin="0,8,0,0" IsEnabled="False">
            <TextBlock Text="Selected Variable" FontWeight="SemiBold" />
            <TextBlock Text="Name:" />
            <TextBox Name="TbVarName" />
            <TextBlock Text="Type:" Margin="0,4,0,0" />
            <ComboBox Name="CbVarType" HorizontalAlignment="Stretch" />
            <TextBlock Text="Object:" Margin="0,4,0,0" />
            <ComboBox Name="CbVarObject" HorizontalAlignment="Stretch" />
            <TextBlock Text="Property:" Margin="0,4,0,0" />
            <ComboBox Name="CbVarProp" HorizontalAlignment="Stretch" />
            <TextBlock Name="TbVarUnit" Text="Units: -" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.8" />
            <TextBlock Text="Initial Value:" Margin="0,4,0,0" />
            <TextBox Name="TbVarInitial" />
            <Grid ColumnDefinitions="*,8,*">
              <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="Lower Limit:" />
                <TextBox Name="TbVarLower" />
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="2">
                <TextBlock Text="Upper Limit:" />
                <TextBox Name="TbVarUpper" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>

      </DockPanel>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" HorizontalAlignment="Stretch" />

      <!-- ===== Right: log ===== -->
      <DockPanel Grid.Column="4">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="8,0,0,6">
          <TextBlock Text="Run Log" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Name="BtnCopyResults" Classes="panel" Content="Copy to Clipboard" FontSize="{DynamicResource FontSizeSmall}" />
        </StackPanel>
        <TextBox Name="TbResults"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 FontFamily="Consolas,Courier New,monospace"
                 FontSize="{DynamicResource FontSizeNormal}"
                 VerticalContentAlignment="Top"
                 Margin="8,0,0,0" />
      </DockPanel>

    </Grid>

  </DockPanel>

</Window>
