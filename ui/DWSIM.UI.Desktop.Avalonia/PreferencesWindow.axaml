<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DWSIM.UI.Desktop.Avalonia.PreferencesWindow"
        Title="General Settings"
        Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel LastChildFill="True" Margin="0">

    <!-- Footer buttons -->
    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="12,8">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Name="BtnCancel" Classes="dialog" Content="Cancel" Width="80" IsCancel="True" />
        <Button Name="BtnOK"     Classes="dialog" Content="OK"     Width="80" IsDefault="True" />
      </StackPanel>
    </Border>

    <!-- the tabs are built in code, one per group of the Windows settings form -->
    <TabControl Name="Tabs" Margin="8,8,8,0" />

  </DockPanel>

</Window>
