<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DWSIM.UI.Desktop.Avalonia"
             xmlns:ctrls="clr-namespace:DWSIM.UI.Desktop.Avalonia.Controls"
             x:Class="DWSIM.UI.Desktop.Avalonia.FlowsheetView">

  <DockPanel Name="RootPanel" LastChildFill="True">

    <!-- ===== Menu Bar ===== -->
    <Menu DockPanel.Dock="Top" Name="MainMenuBar">
      <MenuItem Header="_File">
        <MenuItem Header="_New"            Name="MenuNew"     InputGesture="Ctrl+N" />
        <MenuItem Header="_Open..."        Name="MenuOpen"    InputGesture="Ctrl+O" />
        <MenuItem Header="Open _Recent"    Name="MenuRecent" />
        <Separator />
        <MenuItem Header="_Save"           Name="MenuSave"    InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As..."     Name="MenuSaveAs"  InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="_Export Flowsheet">
          <MenuItem Header="To _PNG Image..." Name="MenuExportPNG" />
          <MenuItem Header="To _SVG File..."  Name="MenuExportSVG" />
          <MenuItem Header="To P_DF File..."  Name="MenuExportPDF" />
        </MenuItem>
        <Separator />
        <MenuItem Header="_Close"          Name="MenuClose"   InputGesture="Ctrl+Q" />
      </MenuItem>
      <MenuItem Header="E_dit">
        <MenuItem Header="_Undo"           Name="MenuUndo"    InputGesture="Ctrl+Z" />
        <MenuItem Header="_Redo"           Name="MenuRedo"    InputGesture="Ctrl+Y" />
        <Separator />
        <MenuItem Header="Cu_t"            Name="MenuCut"     InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy"           Name="MenuCopy"    InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste"          Name="MenuPaste"   InputGesture="Ctrl+V" />
        <MenuItem Header="Select _All"     Name="MenuSelectAll" InputGesture="Ctrl+A" />
        <MenuItem Header="_Invert Selection" Name="MenuInvertSelection" />
        <MenuItem Header="D_eselect All"   Name="MenuDeselectAll" />
        <MenuItem Header="Remove Selected" Name="MenuDelete" />
        <MenuItem Header="Cl_one Selected" Name="MenuClone" />
        <MenuItem Header="Disconnect All"  Name="MenuDisconnectAll" />
        <Separator />
        <MenuItem Header="Simulation _Settings..." Name="MenuSimSettings" InputGesture="Alt+M" />
        <MenuItem Header="_General Settings..."    Name="MenuGlobalSettings" InputGesture="Alt+G" />
      </MenuItem>
      <MenuItem Header="_Solver">
        <MenuItem Header="_Solve"                Name="MenuSolve"       InputGesture="F5" />
        <MenuItem Header="_Force Solve"          Name="MenuSolveCustom" InputGesture="Ctrl+Alt+F5" />
        <MenuItem Header="_Abort"                Name="MenuStop" />
        <Separator />
        <MenuItem Header="Flowsheet _Calculator Active" Name="MenuCalculatorActive" ToggleType="CheckBox" InputGesture="F6" />
        <MenuItem Header="Si_multaneous Adjust Solver"  Name="MenuSimultAdjust"     ToggleType="CheckBox" InputGesture="F7" />
      </MenuItem>
      <MenuItem Header="_Tools">
        <MenuItem Header="_Unit Operation Extension Manager..." Name="MenuUOExtManager" />
        <MenuItem Header="Create C_ompound..."       Name="MenuCreateCompound" />
        <MenuItem Header="Create _Biomass Compound..." Name="MenuBiomassCompound" />
        <Separator />
        <MenuItem Header="Petroleum C7+ C_haracterization..." Name="MenuPetroleumChar" />
        <MenuItem Header="_Distillation Curve Characterization..." Name="MenuDistCurve" />
        <MenuItem Header="Bulk Add Pseudo_compounds..." Name="MenuBulkPseudos" />
        <MenuItem Header="Petroleum _Assay Manager..."  Name="MenuAssayManager" />
        <MenuItem Header="_Pure Compound Properties..." Name="MenuPureComp" />
        <Separator />
        <MenuItem Header="_Reaction Manager..."      Name="MenuReactions" />
        <MenuItem Header="Data _Regression..."       Name="MenuDataRegression" />
        <MenuItem Header="Script _Manager..."        Name="MenuScripts" />
        <MenuItem Header="Systems of _Units..."      Name="MenuUnitSystems" />
        <Separator />
        <MenuItem Header="_Inspector Reports..."     Name="MenuInspector" />
      </MenuItem>
      <MenuItem Header="_Insert">
        <MenuItem Header="Simulation _Object..." Name="MenuAddObject" InputGesture="Alt+A">
          <MenuItem Header="Material Stream"   Name="MenuAddMaterialStream" />
          <MenuItem Header="Energy Stream"     Name="MenuAddEnergyStream" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Property Table"        Name="MenuAddTable" />
        <MenuItem Header="Master Property Table" Name="MenuAddMasterTable" />
        <MenuItem Header="Spreadsheet Table"     Name="MenuAddSpreadsheetTable" />
        <MenuItem Header="Chart Object"          Name="MenuAddChart" />
        <Separator />
        <MenuItem Header="Text Block"            Name="MenuAddText" />
        <MenuItem Header="HTML Text Block"       Name="MenuAddHTMLText" />
        <MenuItem Header="Rectangle"             Name="MenuAddRectangle" />
        <MenuItem Header="Button"                Name="MenuAddButton" />
        <MenuItem Header="Image..."              Name="MenuAddImage" />
      </MenuItem>
      <MenuItem Header="_Dynamics">
        <MenuItem Header="Dynamic Mode _Active"    Name="MenuDynamicsToggle" />
        <MenuItem Header="Dynamics _Wizard"        Name="MenuDynWizard" />
        <MenuItem Header="_Dynamics Manager"       Name="MenuDynManager" />
        <MenuItem Header="_Integrator Controls"    Name="MenuDynIntegrator" />
        <MenuItem Header="_PID Controller Tuning"  Name="MenuDynPIDTuning" />
      </MenuItem>
      <MenuItem Header="_Utilities">
        <MenuItem Header="Pressure Safety _Valve Sizing..." Name="MenuPsvSizing" />
        <MenuItem Header="_Gas-Liquid Separator Sizing..." Name="MenuSepSizing" />
        <MenuItem Header="_Binary Envelope..."        Name="MenuUtilBE" />
        <MenuItem Header="Ternary Envelope (_LLE)..." Name="MenuUtilLLE" />
        <MenuItem Header="_Phase Envelope..."         Name="MenuUtilPE" />
        <MenuItem Header="_True Critical Point..."    Name="MenuUtilTCP" />
        <MenuItem Header="Petroleum Cold _Flow Properties..." Name="MenuColdFlow" />
        <MenuItem Header="Natural Gas H_ydrates..."   Name="MenuHydrates" />
      </MenuItem>
      <MenuItem Header="Flowsheet _Analysis">
        <MenuItem Header="_Sensitivity Analysis..."  Name="MenuSensitivity" />
        <MenuItem Header="_Multivariate Optimizer..." Name="MenuOptimizer" />
        <MenuItem Header="Mass and Energy _Balance Summary..." Name="MenuBalance" />
        <MenuItem Header="Property _Chart..."        Name="MenuPropertyChart" />
      </MenuItem>
      <MenuItem Header="_Results">
        <MenuItem Header="_Results Report..."         Name="MenuResultsReport" />
        <MenuItem Header="_Markdown Report Viewer..." Name="MenuMarkdownReport" />
      </MenuItem>
      <MenuItem Header="_Plugins" Name="MenuPlugins" />
      <MenuItem Header="_View">
        <MenuItem Header="Show _Editor Panel"      Name="MenuShowEditor" />
        <MenuItem Header="Show _Object Palette"    Name="MenuShowPalette" />
        <MenuItem Header="Show _Log Panel"         Name="MenuShowResults" />
        <MenuItem Header="Show _Watch Panel"       Name="MenuShowWatch" />
        <MenuItem Header="Show _Sub-Toolbar"       Name="MenuShowSubToolbar" />
        <Separator />
        <MenuItem Header="Close All Opened _Editors" Name="MenuCloseAllEditors" />
        <Separator />
        <MenuItem Header="_Zoom In"        Name="MenuZoomIn" />
        <MenuItem Header="Zoom _Out"       Name="MenuZoomOut" />
        <MenuItem Header="Fit to _Window"  Name="MenuZoomFit" />
        <MenuItem Header="_Reset Zoom"     Name="MenuZoomReset" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_User Guide (HTML)..."   Name="MenuHelpHtml" />
        <Separator />
        <MenuItem Header="_Support"                Name="MenuHelpSupport" />
        <MenuItem Header="Report a _Bug"           Name="MenuHelpBug" />
        <MenuItem Header="Go to DWSIM's _Website"  Name="MenuHelpWebsite" />
        <Separator />
        <MenuItem Header="_About DWSIM..."         Name="MenuAbout" />
      </MenuItem>
    </Menu>

    <!-- ===== Toolbar =====
         Grouped like the WinForms flowsheet toolbar: settings, steady-state solver,
         undo/redo, dynamics solver, then the flowsheet states. -->
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="4,2">
      <StackPanel Orientation="Horizontal" Spacing="2">

        <Button Name="BtnSave"    Classes="toolbar" ToolTip.Tip="Save"                        Content="💾" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnSimSettings" Classes="toolbar" ToolTip.Tip="Simulation Settings (Alt+M)" Content="⚙" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnUnitOpsExt"  Classes="toolbar" ToolTip.Tip="UnitOps Extensions"      Content="🧩" FontSize="{DynamicResource ToolbarIconSize}" />

        <Separator />
        <TextBlock Text="Steady-State Solver" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7" Margin="4,0,2,0" />
        <ToggleButton Name="BtnCalculatorActive" Classes="toolbar" ToolTip.Tip="Flowsheet Calculator Active (F6)" Content="⏻" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button       Name="BtnSolveForce" Classes="toolbar" ToolTip.Tip="Force Solve"        Content="⏩" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button       Name="BtnSolve"      Classes="toolbar" ToolTip.Tip="Solve (F5)"         Content="▶" FontSize="{DynamicResource ToolbarIconSize}" Foreground="Green" />
        <Button       Name="BtnStop"       Classes="toolbar" ToolTip.Tip="Abort"              Content="⏹" FontSize="{DynamicResource ToolbarIconSize}" Foreground="Red" />
        <ToggleButton Name="BtnSimultAdjust" Classes="toolbar" ToolTip.Tip="Simultaneous Adjust Solver Active (F7)" Content="⚡" FontSize="{DynamicResource ToolbarIconSize}" />

        <Separator />
        <Button Name="BtnUndo"    Classes="toolbar" ToolTip.Tip="Undo (Ctrl+Z)" Content="↩" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnRedo"    Classes="toolbar" ToolTip.Tip="Redo (Ctrl+Y)" Content="↪" FontSize="{DynamicResource ToolbarIconSize}" />

        <Separator />
        <TextBlock Text="Dynamics Solver" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7" Margin="4,0,2,0" />
        <ToggleButton Name="BtnDynamicsMode" Classes="toolbar" ToolTip.Tip="Dynamic Mode Active/Inactive" Content="🕒" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button       Name="BtnDynManager"   Classes="toolbar" ToolTip.Tip="Dynamics Manager"   Content="📋" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button       Name="BtnDynIntegrator" Classes="toolbar" ToolTip.Tip="Integrator Controls" Content="⏱" FontSize="{DynamicResource ToolbarIconSize}" />

        <Separator />
        <TextBlock Text="Flowsheet States" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Opacity="0.7" Margin="4,0,2,0" />
        <ComboBox Name="CbStoredSolutions" Width="150" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" />
        <Button Name="BtnStoreSolution"  Classes="toolbar" ToolTip.Tip="Store Current"    Content="➕" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnLoadSolution"   Classes="toolbar" ToolTip.Tip="Restore Selected" Content="♻" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnDeleteSolution" Classes="toolbar" ToolTip.Tip="Remove Selected"  Content="🗑" FontSize="{DynamicResource ToolbarIconSize}" />

      </StackPanel>
    </Border>

    <!-- ===== Drawing toolbar (single line, moved into the flowsheet document at run time) =====
         Canvas-specific controls: zoom, connect, delete, inspector, then a divider and the
         grid/align/search group (toggled by View > Show Sub-Toolbar). -->
    <Border DockPanel.Dock="Top" BorderThickness="0,0,0,1" Padding="4,2" Name="DrawingToolbarBorder">
      <WrapPanel Orientation="Horizontal">
        <Button Name="BtnZoomIn"  Classes="toolbar" ToolTip.Tip="Zoom In"       Content="🔍+" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnZoomOut" Classes="toolbar" ToolTip.Tip="Zoom Out"      Content="🔍-" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnZoomFit" Classes="toolbar" ToolTip.Tip="Fit to Window" Content="⊡"  FontSize="{DynamicResource ToolbarIconSize}" />
        <Button Name="BtnZoomReset" Classes="toolbar" ToolTip.Tip="Reset Zoom (100%)" Content="1:1" FontSize="{DynamicResource FontSizeSmall}" />
        <Border Classes="vdivider" />
        <ToggleButton Name="BtnConnect" Classes="toolbar" ToolTip.Tip="Connect Objects (click source, then target)" Content="⇒" FontSize="{DynamicResource ToolbarIconSize}" />
        <Button       Name="BtnDelete"  Classes="toolbar" ToolTip.Tip="Delete Selected Object (Del)" Content="✕" FontSize="{DynamicResource ToolbarIconSize}" Foreground="Red" />
        <ToggleButton Name="BtnInspector" Classes="toolbar" ToolTip.Tip="Enable/Disable Inspector" Content="🔎" FontSize="{DynamicResource ToolbarIconSize}" />

        <Border Classes="vdivider" />

        <WrapPanel Name="SubToolbarGroup" Orientation="Horizontal" VerticalAlignment="Center">
          <CheckBox Name="ChkDrawGrid" Content="Grid" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" />
          <CheckBox Name="ChkSnapToGrid" Content="Snap" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" />
          <CheckBox Name="ChkMultiSelect" Content="Multi-Select" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" />
          <Border Classes="vdivider" />
          <TextBlock Text="Align:" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Margin="4,0,2,0" />
          <Button Name="BtnAlignLeft"   Classes="subtoolbar" ToolTip.Tip="Align Lefts"   Content="⇤" />
          <Button Name="BtnAlignCenter" Classes="subtoolbar" ToolTip.Tip="Align Centers" Content="⇔" />
          <Button Name="BtnAlignRight"  Classes="subtoolbar" ToolTip.Tip="Align Rights"  Content="⇥" />
          <Button Name="BtnAlignTop"    Classes="subtoolbar" ToolTip.Tip="Align Tops"    Content="⬆" />
          <Button Name="BtnAlignMiddle" Classes="subtoolbar" ToolTip.Tip="Align Middles" Content="⇕" />
          <Button Name="BtnAlignBottom" Classes="subtoolbar" ToolTip.Tip="Align Bottoms" Content="⬇" />
          <Button Name="BtnEqualizeH"   Classes="subtoolbar" ToolTip.Tip="Equalize Horizontal Spacing" Content="↔" />
          <Button Name="BtnEqualizeV"   Classes="subtoolbar" ToolTip.Tip="Equalize Vertical Spacing"   Content="↕" />
          <Border Classes="vdivider" />
          <TextBlock Text="Search:" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" Margin="4,0,2,0" />
          <TextBox Name="TbSearch" Width="140" Watermark="Find object..." FontSize="{DynamicResource FontSizeSmall}"
                   VerticalAlignment="Center" VerticalContentAlignment="Center" />
        </WrapPanel>
      </WrapPanel>
    </Border>

    <!-- ===== Extension containers (used by DWSIM.Support and other extensions) ===== -->
    <StackPanel Name="TopContainerPanel" DockPanel.Dock="Top" />
    <StackPanel Name="BottomContainerPanel" DockPanel.Dock="Bottom" />
    <StackPanel Name="LeftContainerPanel" DockPanel.Dock="Left" />
    <StackPanel Name="RightContainerPanel" DockPanel.Dock="Right" />

    <!-- ===== Main Area (Dock.Avalonia layout created in code-behind) ===== -->
    <Border Name="MainDockHost" />

  </DockPanel>

</UserControl>
