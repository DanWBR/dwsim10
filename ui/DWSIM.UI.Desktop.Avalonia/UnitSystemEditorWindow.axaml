<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DWSIM.UI.Desktop.Avalonia.UnitSystemEditorWindow"
        x:CompileBindings="False"
        Title="Systems of Units"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="8" LastChildFill="True">

    <Border DockPanel.Dock="Top" Padding="0,0,0,8" BorderThickness="0,0,0,1" Margin="0,0,0,8">
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="System:" VerticalAlignment="Center" />
          <ComboBox Name="CbSystem" Width="200" />
          <Button Name="BtnNew" Classes="panel" Content="New" Width="70" />
          <Button Name="BtnClone" Classes="panel" Content="Duplicate" Width="90" />
          <Button Name="BtnDelete" Classes="panel" Content="Delete" Width="70" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Text="Name:" VerticalAlignment="Center" Width="52" />
          <TextBox Name="TbName" Width="200" />
          <CheckBox Name="ChkActive" Content="Use in this simulation" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="TbNote" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                   Text="The built-in SI, CGS and ENG sets are read-only. Duplicate one to create an editable set; custom sets are stored with the simulation." />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                HorizontalAlignment="Right" Margin="0,8,0,0">
      <TextBlock Name="TbStatus" Text="" VerticalAlignment="Center" FontSize="11" Opacity="0.8" />
      <Button Name="BtnClose" Classes="dialog" Content="Close" Width="80" IsCancel="True" />
    </StackPanel>

    <ScrollViewer Name="UnitsHost" />

  </DockPanel>

</Window>
