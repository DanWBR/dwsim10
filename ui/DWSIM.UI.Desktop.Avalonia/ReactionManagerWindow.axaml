<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DWSIM.UI.Desktop.Avalonia.ReactionManagerWindow"
        Title="Reaction Manager"
        Width="860" Height="580"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

  <DockPanel Margin="8" LastChildFill="True">

    <Button DockPanel.Dock="Bottom" Name="BtnClose" Classes="dialog"
            Content="Close" Width="80" IsCancel="True"
            HorizontalAlignment="Right" Margin="0,8,0,0" />

    <TabControl>

      <!-- ===== Reaction Sets tab (first, as in the classic UI) ===== -->
      <TabItem Header="Reaction Sets">
        <Grid ColumnDefinitions="230,4,*">

          <!-- Left: sets list -->
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        Spacing="4" Margin="0,6,0,0">
              <Button Name="BtnNewReactionSet"    Classes="panel" Content="New..."  Width="78" />
              <Button Name="BtnDeleteReactionSet" Classes="panel" Content="Delete"  Width="70" />
            </StackPanel>
            <ListBox Name="LbReactionSets" />
          </DockPanel>

          <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                        HorizontalAlignment="Stretch" />

          <!-- Right: reactions in set / all reactions -->
          <Grid Grid.Column="2" RowDefinitions="*,Auto,*">

            <!-- Reactions in selected set -->
            <DockPanel Grid.Row="0">
              <TextBlock DockPanel.Dock="Top" Text="Reactions in Selected Set"
                         FontWeight="SemiBold" Margin="8,0,0,4" />
              <ListBox Name="LbSetReactions" Margin="8,0,4,0" />
            </DockPanel>

            <!-- Transfer buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal"
                        HorizontalAlignment="Center" Spacing="12" Margin="0,6,0,6">
              <Button Name="BtnAddToSet"      Classes="panel" Content="▲ Add to Set"   Width="120" />
              <Button Name="BtnRemoveFromSet" Classes="panel" Content="▼ Remove"       Width="120" />
            </StackPanel>

            <!-- All reactions (picker) -->
            <DockPanel Grid.Row="2">
              <TextBlock DockPanel.Dock="Top" Text="All Reactions (pick to add)"
                         FontWeight="SemiBold" Margin="8,0,0,4" />
              <ListBox Name="LbAllReactionsForSet" Margin="8,0,4,0" />
            </DockPanel>

          </Grid>

        </Grid>
      </TabItem>

      <!-- ===== Reactions tab ===== -->
      <TabItem Header="Reactions">
        <Grid ColumnDefinitions="230,4,*">

          <!-- Left: reaction list -->
          <DockPanel Grid.Column="0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                        Spacing="4" Margin="0,6,0,0">
              <Button Name="BtnNewReaction"    Classes="panel" Content="New..."  Width="78" />
              <Button Name="BtnDeleteReaction" Classes="panel" Content="Delete"  Width="70" />
            </StackPanel>
            <ListBox Name="LbReactions" />
          </DockPanel>

          <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                        HorizontalAlignment="Stretch" />

          <!-- Right: detail -->
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Reaction Properties"
                       FontWeight="SemiBold" Margin="8,0,0,6" />
            <ScrollViewer>
              <StackPanel Name="ReactionDetailPanel" Spacing="4" Margin="8,0,4,0">
                <TextBlock Name="ReactionDetailHint"
                           Text="Select or create a reaction to view/edit its properties."
                           TextWrapping="Wrap" Foreground="Gray" />
              </StackPanel>
            </ScrollViewer>
          </DockPanel>

        </Grid>
      </TabItem>

    </TabControl>

  </DockPanel>

</Window>
