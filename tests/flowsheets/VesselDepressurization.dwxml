      <DynamicPropertiesDescriptions>
        <Property>
          <Name>Actuator Delay</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Valve Actuator Delay (dead time in seconds). Set to 0 to disable."</Data>
        </Property>
        <Property>
          <Name>Actuator Time Constant</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"First-order lag time constant for actuator response (s). Set to 0 for instantaneous."</Data>
        </Property>
        <Property>
          <Name>Opening Setpoint</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Target valve opening (%). Actuator moves towards this value."</Data>
        </Property>
        <Property>
          <Name>Cavitation Alarm</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"True if cavitation is detected (dP &gt; FL^2*(P1-Pv))."</Data>
        </Property>
        <Property>
          <Name>Liquid Pressure Recovery Factor FL</Name>
          <PropertyType>System.String</PropertyType>
          <Data>"Liquid pressure recovery factor (typically 0.8-0.95)."</Data>
        </Property>
